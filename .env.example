# Copy to .env (git-ignored) and fill in. docker compose refuses to start the
# editor without the two passwords.
OFM_EDITOR_USER=ofm
OFM_EDITOR_PASSWORD=          # e.g. openssl rand -hex 16
OFM_PG_PASSWORD=              # password of OFM_PG_USER on the shared PostGIS
# Optional overrides
# OFM_PG_HOST=51.15.160.236
# OFM_PG_PORT=45432
# OFM_PG_USER=admin
# OFM_CORS_ORIGINS=http://51.15.160.236:8766

# Label reading on scans: any OpenAI-compatible endpoint with a vision model.
# OpenRouter (default):   OFM_LLM_API_KEY=sk-or-...        (models: https://openrouter.ai/models)
# Private server:         OFM_LLM_BASE_URL=http://my-vllm:8000/v1   (key optional)
# OFM_LLM_BASE_URL=https://openrouter.ai/api/v1
# OFM_LLM_API_KEY=
# OFM_LLM_MODEL=google/gemini-2.5-flash
