# Copy to .env (git-ignored) and fill in. docker compose refuses to start the
# editor without the two passwords.
OFM_EDITOR_USER=ofm
OFM_EDITOR_PASSWORD=          # e.g. openssl rand -hex 16
OFM_PG_PASSWORD=              # password of OFM_PG_USER on the shared PostGIS
# Optional overrides
# OFM_PG_HOST=51.15.160.236
# OFM_PG_PORT=45432
# OFM_PG_USER=admin
# OFM_CORS_ORIGINS=http://51.15.160.236:8766
